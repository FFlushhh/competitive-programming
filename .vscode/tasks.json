{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C++: Build active file",
            "command": "/opt/homebrew/bin/g++-15",
            "args": [
                "${file}",
                "-std=gnu++23",
                "-O2",
                "-Wall",
                "-Wextra",
                "-g",
                "-I",
                "${workspaceFolder}/Library",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "windows": {
                "command": "C:\\mingw64\\bin\\g++.exe",
                "args": [
                    "${file}",
                    "-std=gnu++23",
                    "-O2",
                    "-Wall",
                    "-Wextra",
                    "-g",
                    "-I",
                    "${workspaceFolder}\\Library",
                    "-o",
                    "${fileDirname}\\${fileBasenameNoExtension}.exe"
                ]
            },
            "osx": {
                "command": "/opt/homebrew/bin/g++-15",
                "args": [
                    "${file}",
                    "-std=gnu++23",
                    "-O2",
                    "-Wall",
                    "-Wextra",
                    "-g",
                    "-I",
                    "${workspaceFolder}/Library",
                    "-o",
                    "${fileDirname}/${fileBasenameNoExtension}"
                ]
            },
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}