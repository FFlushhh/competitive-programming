        "scope": "cpp",
        "prefix": "prime_factorization",
        "body": [
            "/* Reference: https://github.com/FFlushhh/competitive-programming/blob/main/.vscode/cpp.code-snippets */",
            "/// @brief 正の整数を素因数分解する",
            "/// @details 各素因数について割り切れる回数を数え、素因数と指数の組を昇順で格納する",
            "/// @param[in] n 素因数分解する1以上の整数",
            "/// @return 各要素が{素因数, 指数}であるvector",
            "vector<pair<long long, long long>> prime_factorization(long long n)",
            "{",
            "    vector<pair<long long, long long>> factors;",
            "",
            "    for (long long prime = 2; prime <= n / prime; ++prime) {",
            "        if (n % prime != 0) {",
            "            continue;",
            "        }",
            "",
            "        long long exponent = 0;",
            "",
            "        while (n % prime == 0) {",
            "            n /= prime;",
            "            ++exponent;",
            "        }",
            "",
            "        factors.emplace_back(prime, exponent);",
            "    }",
            "",
            "    if (n > 1) {",
            "        factors.emplace_back(n, 1);",
            "    }",
            "",
            "    return factors;",
            "}",
            "",
            "/*",
            "[prime_factorization]",
            "",
            "使い方:",
            "    vector<pair<long long, long long>> factors =",
            "        prime_factorization(n);",
            "",
            "時間計算量:",
            "    O(√N)",
            "",
            "空間計算量:",
            "    補助領域: O(1)",
            "    戻り値を含む場合: O(log N)",
            "*/",
            "",
            "${1}"
        ],
        "description": "試し割りによって整数を素因数分解する関数"
