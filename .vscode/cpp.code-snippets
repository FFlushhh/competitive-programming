    "Union-Find（ACL互換 dsu）": {
        "scope": "cpp",
        "prefix": "unionfind",
        "body": [
            "/* Reference: https://github.com/FFlushhh/competitive-programming/blob/main/.vscode/cpp.code-snippets */",
            "/* Based on AtCoder Library dsu (CC0) */",
            "/// @brief 素集合を効率的に管理するDisjoint Set Union",
            "/// @details Union by Sizeと経路圧縮を用い、AtCoder Libraryのdsuと同じAPIを提供する",
            "struct dsu {",
            "public:",
            "    /// @brief 空のDSUを構築する",
            "    dsu() : _n(0) {}",
            "",
            "    /// @brief n個の独立した要素を持つDSUを構築する",
            "    /// @param[in] n 管理する要素数",
            "    explicit dsu(int n)",
            "        : _n(n), parent_or_size(n, -1)",
            "    {",
            "    }",
            "",
            "    /// @brief 2要素が属する連結成分を統合する",
            "    /// @param[in] a 統合する要素",
            "    /// @param[in] b 統合する要素",
            "    /// @return 統合後の連結成分のleader",
            "    int merge(int a, int b)",
            "    {",
            "        assert(0 <= a && a < _n);",
            "        assert(0 <= b && b < _n);",
            "",
            "        int x = leader(a);",
            "        int y = leader(b);",
            "",
            "        if (x == y) {",
            "            return x;",
            "        }",
            "",
            "        if (-parent_or_size[x] < -parent_or_size[y]) {",
            "            std::swap(x, y);",
            "        }",
            "",
            "        parent_or_size[x] += parent_or_size[y];",
            "        parent_or_size[y] = x;",
            "",
            "        return x;",
            "    }",
            "",
            "    /// @brief 2要素が同じ連結成分に属するか判定する",
            "    /// @param[in] a 判定する要素",
            "    /// @param[in] b 判定する要素",
            "    /// @return 同じ連結成分ならtrue、そうでなければfalse",
            "    bool same(int a, int b)",
            "    {",
            "        assert(0 <= a && a < _n);",
            "        assert(0 <= b && b < _n);",
            "",
            "        return leader(a) == leader(b);",
            "    }",
            "",
            "    /// @brief 要素が属する連結成分のleaderを取得する",
            "    /// @param[in] a 対象要素",
            "    /// @return aが属する連結成分のleader",
            "    int leader(int a)",
            "    {",
            "        assert(0 <= a && a < _n);",
            "",
            "        return _leader(a);",
            "    }",
            "",
            "    /// @brief 要素が属する連結成分の要素数を取得する",
            "    /// @param[in] a 対象要素",
            "    /// @return aが属する連結成分の要素数",
            "    int size(int a)",
            "    {",
            "        assert(0 <= a && a < _n);",
            "",
            "        return -parent_or_size[leader(a)];",
            "    }",
            "",
            "    /// @brief すべての連結成分を列挙する",
            "    /// @return 各連結成分の要素を格納したvector",
            "    std::vector<std::vector<int>> groups()",
            "    {",
            "        std::vector<int> leader_buf(_n);",
            "        std::vector<int> group_size(_n);",
            "",
            "        for (int i = 0; i < _n; ++i) {",
            "            leader_buf[i] = leader(i);",
            "            ++group_size[leader_buf[i]];",
            "        }",
            "",
            "        std::vector<std::vector<int>> result(_n);",
            "",
            "        for (int i = 0; i < _n; ++i) {",
            "            result[i].reserve(group_size[i]);",
            "        }",
            "",
            "        for (int i = 0; i < _n; ++i) {",
            "            result[leader_buf[i]].push_back(i);",
            "        }",
            "",
            "        result.erase(",
            "            std::remove_if(",
            "                result.begin(),",
            "                result.end(),",
            "                [&](const std::vector<int>& v) {",
            "                    return v.empty();",
            "                }),",
            "            result.end());",
            "",
            "        return result;",
            "    }",
            "",
            "private:",
            "    int _n;",
            "",
            "    // root node: -1 * component size",
            "    // otherwise: parent",
            "    std::vector<int> parent_or_size;",
            "",
            "    /// @brief 経路圧縮を行いながらleaderを取得する内部関数",
            "    /// @param[in] a 対象要素",
            "    /// @return aが属する連結成分のleader",
            "    int _leader(int a)",
            "    {",
            "        if (parent_or_size[a] < 0) {",
            "            return a;",
            "        }",
            "",
            "        return parent_or_size[a] = _leader(parent_or_size[a]);",
            "    }",
            "};",
            "",
            "/*",
            "[dsu / Union-Find]",
            "",
            "使い方:",
            "    dsu d(n);",
            "",
            "    d.merge(a, b);",
            "    bool connected = d.same(a, b);",
            "    int representative = d.leader(a);",
            "    int component_size = d.size(a);",
            "    vector<vector<int>> components = d.groups();",
            "",
            "注意:",
            "    要素番号は0-indexedで、0 <= a, b < n。",
            "",
            "時間計算量:",
            "    コンストラクタ: O(N)",
            "    merge:  償却 O(α(N))",
            "    same:   償却 O(α(N))",
            "    leader: 償却 O(α(N))",
            "    size:   償却 O(α(N))",
            "    groups: O(N)",
            "",
            "空間計算量:",
            "    O(N)",
            "*/",
            "",
            "${1}"
        ],
        "description": "AtCoder Libraryのdsuと同じAPI・挙動を再現したDisjoint Set Union"
    },

    "Rolling Hash": {
        "scope": "cpp",
        "prefix": "rolling_hash",
        "body": [
            "/* Reference: https://github.com/FFlushhh/competitive-programming/blob/main/.vscode/cpp.code-snippets */",
            "/// @brief 部分文字列のハッシュ値を高速に取得するRolling Hash",
            "/// @details 文字列のprefix hashとbaseの累乗を前計算し、半開区間のハッシュ値を定数時間で求める",
            "class RollingHash {",
            "public:",
            "    /// @brief 文字列からRolling Hashを構築する",
            "    /// @param[in] text 前処理する文字列",
            "    explicit RollingHash(const string& text)",
            "    {",
            "        int n = text.size();",
            "        hash_values_.assign(n + 1, 0);",
            "        powers_.assign(n + 1, 1);",
            "",
            "        for (int i = 0; i < n; ++i) {",
            "            hash_values_[i + 1] =",
            "                (hash_values_[i] * base + text[i]) % mod;",
            "            powers_[i + 1] = (powers_[i] * base) % mod;",
            "        }",
            "    }",
            "",
            "    /// @brief 指定した部分文字列のハッシュ値を取得する",
            "    /// @param[in] left 半開区間の左端",
            "    /// @param[in] right 半開区間の右端",
            "    /// @return text[left, right)に対応するハッシュ値",
            "    long long get_hash(int left, int right) const",
            "    {",
            "        long long result =",
            "            (hash_values_[right]",
            "             - hash_values_[left] * powers_[right - left]) % mod;",
            "",
            "        if (result < 0) {",
            "            result += mod;",
            "        }",
            "",
            "        return result;",
            "    }",
            "",
            "private:",
            "    static constexpr long long mod = 1000000007LL;",
            "    static constexpr long long base = 9973LL;",
            "",
            "    vector<long long> hash_values_;",
            "    vector<long long> powers_;",
            "};",
            "",
            "/*",
            "[RollingHash]",
            "",
            "使い方:",
            "    RollingHash rolling_hash(text);",
            "    long long hash_value = rolling_hash.get_hash(left, right);",
            "",
            "注意:",
            "    単一modのためハッシュ衝突の可能性がある。",
            "",
            "時間計算量:",
            "    構築: O(N)",
            "    get_hash: O(1)",
            "",
            "空間計算量:",
            "    O(N)",
            "*/",
            "",
            "${1}"
        ],
        "description": "部分文字列のハッシュ値をO(1)で取得するRolling Hash"
    },

