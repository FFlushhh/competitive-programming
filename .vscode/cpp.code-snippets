    "繰り返し二乗法（mod累乗）": {
        "scope": "cpp",
        "prefix": "mod_pow",
        "body": [
            "/* Reference: https://github.com/FFlushhh/competitive-programming/blob/main/.vscode/cpp.code-snippets */",
            "/// @brief 繰り返し二乗法で累乗の剰余を求める",
            "/// @details exponentの各ビットを利用してbase^exponent mod modを計算する",
            "/// @param[in] base 底",
            "/// @param[in] exponent 0以上の指数",
            "/// @param[in] mod 正の法",
            "/// @return base^exponentをmodで割った余り",
            "long long mod_pow(long long base, long long exponent, long long mod)",
            "{",
            "    long long result = 1 % mod;",
            "    base %= mod;",
            "",
            "    while (exponent > 0) {",
            "        if (exponent & 1LL) {",
            "            result = (result * base) % mod;",
            "        }",
            "",
            "        base = (base * base) % mod;",
            "        exponent >>= 1;",
            "    }",
            "",
            "    return result;",
            "}",
            "",
            "/*",
            "[mod_pow]",
            "",
            "使い方:",
            "    long long result = mod_pow(base, exponent, mod);",
            "",
            "注意:",
            "    long longの乗算がオーバーフローしない範囲のmodを想定する。",
            "",
            "時間計算量:",
            "    O(log exponent)",
            "",
            "空間計算量:",
            "    O(1)",
            "*/",
            "",
