    "エラトステネスの篩": {
        "scope": "cpp",
        "prefix": "sieve",
        "body": [
            "/* Reference: https://github.com/FFlushhh/competitive-programming/blob/main/.vscode/cpp.code-snippets */",
            "/// @brief n以下の素数をエラトステネスの篩で列挙する",
            "/// @details 素数の倍数を順次除外し、残った2以上の整数を昇順で返す",
            "/// @param[in] n 素数を列挙する上限値",
            "/// @return 0以上n以下に存在する素数を昇順に格納したvector",
            "vector<long long> sieve_of_eratosthenes(long long n)",
            "{",
            "    if (n < 2) {",
            "        return {};",
            "    }",
            "",
            "    vector<bool> is_prime_number(n + 1, true);",
            "    is_prime_number[0] = false;",
            "    is_prime_number[1] = false;",
            "",
            "    for (long long prime = 2; prime <= n / prime; ++prime) {",
            "        if (!is_prime_number[prime]) {",
            "            continue;",
            "        }",
            "",
            "        for (long long multiple = prime * prime;",
            "             multiple <= n;",
            "             multiple += prime) {",
            "            is_prime_number[multiple] = false;",
            "        }",
            "    }",
            "",
            "    vector<long long> primes;",
            "",
            "    for (long long value = 2; value <= n; ++value) {",
            "        if (is_prime_number[value]) {",
            "            primes.push_back(value);",
            "        }",
            "    }",
            "",
            "    return primes;",
            "}",
            "",
            "/*",
            "[sieve_of_eratosthenes]",
            "",
            "使い方:",
            "    vector<long long> primes = sieve_of_eratosthenes(n);",
            "",
            "時間計算量:",
            "    O(N log log N)",
            "",
            "空間計算量:",
            "    O(N)",
            "*/",
            "",
            "${1}"
